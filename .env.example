# Replace these values in an untracked .env file.
MEILI_URL=https://meilisearch.example.com
MEILI_SEARCH_KEY=replace-with-read-only-search-key
MEILI_INDEX=openlist

# Share IDs map to one path or a JSON array of paths.
SHARE_example=/path/to/share-root
# SHARE_another=["/path/one", "/path/two"]

LISTEN_ADDR=127.0.0.1:8099
CORS_ORIGINS=https://www.example.com,http://localhost:5173
